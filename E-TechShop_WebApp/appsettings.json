{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
    },

  "Jwt": {
    "Key": "YOUR_VERY_SECRET_KEY_HERE",
    "Issuer": "https://localhost:5099", //ідентифікатор того, ХТО видав токен
    "Audience": "https://localhost:5099", //кому призначений токен
    "ExpiresMinutes": 60
  }
}
